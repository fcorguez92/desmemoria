anim idle
frame upper cloak legs_idle sword_rest@14,20
frame upper cloak_b legs_idle sword_rest@14,20

anim run
frame upper cloak legs_run1 sword_rest@14,20
frame upper cloak_b legs_run2 sword_rest@14,20
frame upper cloak legs_run3 sword_rest@14,20
frame upper cloak_b legs_run4 sword_rest@14,20

anim jump
frame upper cloak legs_jump sword_rest@14,20

anim fall
frame upper cloak_b legs_fall sword_rest@14,20

anim attack
frame upper cloak legs_idle sword_strike@16,11
frame upper cloak legs_idle sword_strike@16,13
frame upper cloak legs_idle sword_rest@16,20

anim parry
frame upper cloak legs_idle sword_guard@14,5
frame upper cloak legs_idle sword_guard@14,2
